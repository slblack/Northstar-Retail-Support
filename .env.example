# Copy to .env (never commit .env). Values saved later from the Setup dialog take precedence.
# Leave keys blank here and enter them in the app's Setup dialog instead if you prefer.
OPENAI_API_KEY=
RETAIL_AI_DEFENSE_API_KEY=

# OpenAI API model used identically on both comparison paths (Responses API).
OPENAI_MODEL=gpt-6-luna
# Upper bound on generated tokens per answer (64–4000).
OPENAI_MAX_OUTPUT_TOKENS=800

# Cisco AI Defense inspection region: us, eu or ap. Must match your tenant.
AI_DEFENSE_REGION=us
# Optional reminder of your inspection connection name (not used to authenticate).
AI_DEFENSE_CONNECTION_NAME=
